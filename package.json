{
  "name": "capitune-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "node scripts/dev-port.mjs 3001",
    "dev:port": "node scripts/dev-port.mjs",
    "dev:3001": "next dev -p 3001",
    "dev:webpack:3001": "next dev --webpack -p 3001",
    "postinstall": "node scripts/prisma.mjs generate",
    "build": "node scripts/vercel-build.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "smoke:maintenance": "node scripts/maintenance-smoke.mjs",
    "smoke:featureflags": "node scripts/feature-flags-smoke.mjs",
    "make:admin": "node scripts/make-admin.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node scripts/prisma.mjs db push",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:seed": "node scripts/prisma.mjs db seed",
    "db:studio": "node scripts/prisma.mjs studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.0",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.3.0",
    "@prisma/client": "^6.19.2",
    "@stripe/stripe-js": "^8.7.0",
    "bcryptjs": "^2.4.3",
    "firebase": "^11.4.0",
    "firebase-admin": "^12.7.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^20.3.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pg": "^8.18.0",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
