# Copie ce fichier en `.env.local` (non commité) et remplis avec les valeurs
# du projet Firebase (les mêmes que dans capituneorg-clone/.env.local, mais avec le préfixe VITE_)

# --- Firebase Web (client) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optionnel
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Gemini (si utilisé) ---
# (Déjà utilisé par vite.config.ts via GEMINI_API_KEY)
GEMINI_API_KEY=

# --- Backend (Next) ---
# URL du backend Next.js qui expose l'API Stripe V3.
# Exemple local si Next tourne sur 3001 :
# VITE_API_BASE_URL=http://localhost:3001
VITE_API_BASE_URL=
