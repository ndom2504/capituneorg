# --- Firebase Web (client) ---
# Copiez ce fichier en `.env.local` et remplissez avec les valeurs de votre projet Firebase.
# Ces variables DOIVENT commencer par NEXT_PUBLIC_ pour être accessibles côté navigateur.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optionnel
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin (server) ---
# Recommandé: un JSON de compte de service encodé en base64.
# Contenu attendu: le JSON entier du service account (clé privée incluse).
FIREBASE_ADMIN_CREDENTIALS_B64=

# Alternative (si vous ne voulez pas de base64):
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# IMPORTANT: mettre les \n littéraux (une seule ligne) pour la clé privée.
# FIREBASE_ADMIN_PRIVATE_KEY=

# --- Stripe (paiements MVP) ---
# Utiliser la clé secrète du compte Stripe (test ou live).
# Exemple: sk_test_... / sk_live_...
STRIPE_SECRET_KEY=

# Webhook signing secret pour l’endpoint `/api/webhooks/stripe`.
# Exemple: whsec_...
STRIPE_WEBHOOK_SECRET=

# IMPORTANT: ne jamais coller de vraies clés dans ce fichier (il est versionné).
# Mettez les valeurs uniquement dans `.env.local` (non commité).

# --- Database (PostgreSQL) ---
# En production (Vercel), utilisez une URL Postgres (Neon / Vercel Postgres / Railway).
# Exemple: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL=

# Recommandé (Prisma migrate): URL non poolée (direct connection)
# Exemple (Vercel Postgres): POSTGRES_URL_NON_POOLING
DIRECT_URL=
