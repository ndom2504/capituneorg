generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DocumentStatus {
  A_FOURNIR
  EN_REVUE
  VALIDE
}

enum DossierStatus {
  LOCAL
  PREINSCRIPTION
  EN_COURS
  TERMINE
}

enum PreRegistrationStatus {
  DRAFT
  SUBMITTED
}

enum CommunicationLanguage {
  FRANCAIS
  ANGLAIS
  AUTRE
}

enum ResidenceSituation {
  PAYS_ORIGINE
  ETRANGER_ETUDES_TRAVAIL
  TEMPORAIRE
}

enum MainObjective {
  ETUDIER
  TRAVAILLER
  ENTREPRENDRE
  FAMILLE
  EXPLORER
  DEMANDE_ASILE
}

enum ProfessionalSituation {
  ETUDIANT
  SALARIE
  ENTREPRENEUR
  SANS_EMPLOI
}

enum MainDomain {
  TECH
  SANTE
  COMMERCE_GESTION
  INGENIERIE
  TECHNIQUE
  AUTRE
}

enum EducationLevel {
  SECONDAIRE
  BAC_LICENCE
  MASTER
  DOCTORAT
  AUTRE
}

enum ExperienceRange {
  ZERO_UN
  DEUX_QUATRE
  CINQ_PLUS
}

enum BudgetRange {
  MOINS_3000
  ENTRE_3000_7000
  ENTRE_7000_15000
  PLUS_15000
  JE_NE_SAIS_PAS
}

enum UserMediaType {
  NONE
  IMAGE
  VIDEO
}

enum AccountType {
  USER
  PROFESSIONAL
  ADMIN
}

// Rôle interne d'administration (uniquement si accountType=ADMIN)
enum AdminRole {
  ADMIN
  MODERATOR
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuditAction {
  VERIFY_PRO
  REJECT_PRO
  SUSPEND_USER
  SUSPEND_PROFILE
  REACTIVATE_PROFILE
  REACTIVATE_USER
  FORCE_LOGOUT
  ADD_ADMIN_NOTE
  REPORT_REVIEW
  REPORT_RESOLVE
  REPORT_DISMISS
  FEATURE_EVENT
  UNFEATURE_EVENT
  SUSPEND_EVENT
  REACTIVATE_EVENT
  DELETE_EVENT
  PUBLISH_JOB
  CLOSE_JOB
  UPDATE_PLATFORM_SETTING
  CREATE_NOTIFICATION_TEMPLATE
  UPDATE_NOTIFICATION_TEMPLATE
  ARCHIVE_NOTIFICATION_TEMPLATE
  RESTORE_NOTIFICATION_TEMPLATE
  SEND_NOTIFICATION
  HIDE_POST
  RESTORE_POST
  DELETE_COMMENT
  LOCK_COMMENTS
  UNLOCK_COMMENTS
  PIN_POST
  UNPIN_POST
  BAN_COMMUNITY
  UNBAN_COMMUNITY
  PUBLISH_ADMIN_POST
  UPDATE_COMMUNITY_RULES
}

enum CommunityPublishMode {
  ADMIN_ONLY
  PRO_ONLY
  ALL_USERS
}

enum CommunityCommentMode {
  ADMIN_ONLY
  PRO_ONLY
  ALL_USERS
}

enum CommunityBannedWordsAction {
  HIDE
  WARN
  BLOCK
}

enum ReportTargetType {
  POST
  COMMENT
  PROFILE
  OFFER
  PRO
  DOSSIER
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum MarketplaceProfession {
  IMMIGRATION_CONSULTANT
  IMMIGRATION_LAWYER
  ORIENTATION_COUNSELOR
  ACADEMIC_COUNSELOR
  EMPLOYMENT_COUNSELOR
  CASE_MANAGER
  CERTIFIED_TRANSLATOR
  INTEGRATION_COACH
  COMMUNITY_ORG
}

enum MarketplaceFormat {
  VISIO
  IN_PERSON
  BOTH
}

enum MarketplaceProfileStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum VerificationStatus {
  DRAFT
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ProfileBadgeType {
  VERIFIED
  PARTNER
  TOP_CONTRIBUTOR
  REGULATED_PROFESSION
  EXPERT
}

enum MarketplacePricingMode {
  FREE
  PAID
}

enum MarketplaceResponseTime {
  H24
  H48
  H72
}

enum MarketplaceRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  NEEDS_INFO
}

enum MarketplaceUrgency {
  LOW
  MEDIUM
  HIGH
}

enum MarketplaceEngagementStatus {
  DRAFT
  CONTRACT_SENT
  SIGNED
  PAYMENT_REQUESTED
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum MarketplaceMilestone {
  ANALYSE
  DOSSIER
  SOUMISSION
}

enum MarketplaceNeedTopic {
  ETUDES
  TRAVAIL
  ENTREPRENEUR
  DOCUMENTS
  BUDGET
  INSTALLATION
  ORIENTATION
  IMMIGRATION
  FAMILLE
  INTEGRATION
  FORMATION
  AUTRE
}

enum MarketplaceMessageSenderRole {
  REQUESTER
  PROFESSIONAL
  SYSTEM
}

enum MarketplaceMessageKind {
  TEXT
  STATUS_UPDATE
  MEETING
  FILE
}

enum PaymentOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PreRegistrationReviewStatus {
  NEW
  IN_REVIEW
  ACCEPTED
  REJECTED
  NEEDS_INFO
}

enum ReviewFeasibility {
  LOW
  MEDIUM
  HIGH
}

enum MeetingType {
  DISCOVERY_CALL
  ORIENTATION
  DOSSIER_FOLLOWUP
  OTHER
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProNetworkRole {
  OWNER
  MEMBER
}

enum EventType {
  LIVE
  WEBINAIRE
  ATELIER
  FORMATION
}

enum EventTheme {
  ETUDES
  TRAVAIL
  ENTREPRENEUR
  DOCUMENTS
  BUDGET
}

// --- PRO : Événements & Formations (V1) ---

enum ProContentType {
  EVENT
  TRAINING
}

enum ProPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProEventStatus {
  DRAFT
  PUBLISHED
  FULL
  ENDED
  CANCELLED
  SUSPENDED
}

enum EventMode {
  ONLINE
  IN_PERSON
}

enum EventRegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
  PENDING_PAYMENT
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ProEventType {
  LIVE
  ATELIER
  QA
}

enum EnrollmentPaymentStatus {
  FREE
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ContentTargetRole {
  ALL
  DEMANDEUR
  PRO
}

enum TrainingFormat {
  VIDEO
  RESOURCES
  MIXED
}

enum EventLevel {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

enum EventFormat {
  LIVE
  REPLAY
}

enum NotificationRole {
  DEMANDEUR
  PRO
}

enum NotificationPriority {
  CRITICAL
  IMPORTANT
  INFO
}

model Notification {
  id     String @id @default(cuid())
  userId String

  role     NotificationRole
  type     String
  title    String
  message  String
  link     String
  priority NotificationPriority @default(INFO)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model NotificationTemplate {
  id String @id @default(cuid())

  role     NotificationRole
  type     String
  title    String
  message  String
  link     String
  priority NotificationPriority @default(INFO)

  archivedAt DateTime?

  createdByAdminId String
  updatedByAdminId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt, createdAt])
  @@index([role, priority, createdAt])
  @@index([type])
  @@index([createdByAdminId, createdAt])
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String?
  fullName      String
  avatarUrl     String?
  coverUrl      String?
  accountType   AccountType   @default(USER)
  roleLocked    Boolean       @default(true)
  adminRole     AdminRole     @default(ADMIN)
  accountStatus AccountStatus @default(ACTIVE)
  isCertified   Boolean       @default(false)

  // Presence / Online status
  lastSeenAt   DateTime?
  statusManual String? // "busy", "away", etc. (facultatif)

  suspendedAt          DateTime?
  deletedAt            DateTime?
  communityBannedAt    DateTime?
  sessionInvalidBefore DateTime?

  createdAt DateTime @default(now())

  settings UserSettings?

  dossiers        Dossier[]
  preRegistration PreRegistration?
  posts           UserPost[]
  postComments    UserPostComment[]
  postLikes       UserPostLike[]

  following Follow[] @relation("FollowFollower")
  followers Follow[] @relation("FollowFollowing")

  contactSent     ContactRequest[] @relation("ContactFrom")
  contactReceived ContactRequest[] @relation("ContactTo")

  partnershipSent     PartnershipRequest[] @relation("PartnershipFrom")
  partnershipReceived PartnershipRequest[] @relation("PartnershipTo")

  proNetworksOwned      ProfessionalNetwork[]       @relation("ProNetworkOwner")
  proNetworkMemberships ProfessionalNetworkMember[]

  eventRegistrations EventRegistration[]
  eventOrders        EventOrder[]
  eventLikes         EventLike[]
  eventsCreated      Event[]              @relation("EventsCreated")

  assignedPreRegistrationReviews PreRegistrationReview[]
  meetingsAsClient               Meeting[]               @relation("MeetingClient")
  meetingsAsPro                  Meeting[]               @relation("MeetingPro")

  marketplaceProfile          MarketplaceProfile?
  marketplaceRequestsSent     MarketplaceRequest[] @relation("MarketplaceRequester")
  marketplaceRequestsReceived MarketplaceRequest[] @relation("MarketplaceProfessional")

  marketplaceEngagementsAsRequester    MarketplaceEngagement[] @relation("MarketplaceEngagementRequester")
  marketplaceEngagementsAsProfessional MarketplaceEngagement[] @relation("MarketplaceEngagementProfessional")
  marketplaceEngagementsSigned         MarketplaceEngagement[] @relation("MarketplaceEngagementSigner")

  // Vérification de profils marketplace en tant qu'admin
  verifiedProfiles MarketplaceProfile[] @relation("ProfileVerifier")

  paymentServices       PaymentService[]
  paymentOrdersBought   PaymentOrder[]   @relation("PaymentOrderBuyer")
  paymentOrdersProvided PaymentOrder[]   @relation("PaymentOrderProvider")

  stripeConnectedAccount StripeConnectedAccount?

  jobPostings     JobPosting[]     @relation("JobPoster")
  jobApplications JobApplication[] @relation("JobApplicant")

  employmentProfile EmploymentProfile?

  notifications Notification[]

  auditLogs          AuditLog[]      @relation("AuditActor")
  adminNotesAuthored UserAdminNote[] @relation("AdminNoteAuthor")
  adminNotesReceived UserAdminNote[] @relation("AdminNoteUser")
  reportsCreated     Report[]        @relation("ReportReporter")
  reportsResolved    Report[]        @relation("ReportResolvedBy")

  // Performance: reviews given and received
  reviewsGiven    Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewProfessional")

  // Messaging
  conversationsInitiated Conversation[] @relation("ConversationInitiator")
  conversationsReceived  Conversation[] @relation("ConversationRecipient")
  messagesSent           Message[]      @relation("MessageSender")
  dossierMessagesSent    DossierMessage[] @relation("DossierMessageSender")

  // Cases (V1)
  casesRequested    Case[]        @relation("CaseRequester")
  casesProfessional Case[]        @relation("CaseProfessional")
  caseMessages      CaseMessage[] @relation("CaseMessageAuthor")

  // PRO content (événements / formations)
  contentItemsOwned ContentItem[] @relation("ContentOwner")
  contentEnrollments Enrollment[]

  platformSettingsUpdated PlatformSetting[] @relation("PlatformSettingUpdatedBy")

  communityRulesUpdated CommunityRules[] @relation("CommunityRulesUpdatedBy")
}

model ContentItem {
  id      String         @id @default(cuid())
  type    ProContentType

  ownerId String
  owner   User           @relation("ContentOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String
  language    String      @default("fr")

  // Event fields
  eventStatus ProEventStatus?
  eventType   ProEventType?
  startsAt    DateTime?
  durationMin Int?
  timezone    String?
  liveUrl     String?
  replayUrl   String?
  capacity    Int?
  imageUrl    String?

  // Training fields
  publishStatus ProPublishStatus @default(DRAFT)
  trainingFormat TrainingFormat?
  level         String?
  videoUrl       String?
  objectivesJson Json?
  resourcesJson  Json?

  // Monetization
  isPaid        Boolean  @default(false)
  priceCents    Int?
  currency      String   @default("cad")
  stripePriceId String?

  // Visibility
  targetRole ContentTargetRole?

  isPinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]

  paymentService PaymentService?

  @@index([ownerId, type, createdAt])
  @@index([type, publishStatus])
  @@index([type, eventStatus])
  @@index([startsAt])
}

model Enrollment {
  id        String   @id @default(cuid())
  contentId String
  userId    String

  paymentStatus    EnrollmentPaymentStatus @default(PENDING)
  stripeSessionId  String?
  paymentOrderId   String?

  createdAt DateTime @default(now())

  content ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contentId, userId])
  @@index([userId, createdAt])
  @@index([contentId, createdAt])
}

enum EmploymentAvailability {
  IMMEDIATE
  ONE_TO_THREE_MONTHS
  MORE_THAN_THREE_MONTHS
}

enum EmploymentWorkPreference {
  CANADA_ONLY
  CANADA_AND_REMOTE
}

enum EmploymentImmigrationSupport {
  YES
  NO
  IN_PROGRESS
}

model EmploymentProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  professionalTitle String
  domain            MainDomain
  experienceLevel   ExperienceLevel
  availability      EmploymentAvailability

  residenceCountry String
  workPreference   EmploymentWorkPreference
  targetProvinces  Json
  contractTypes    Json
  immigrationSupport EmploymentImmigrationSupport

  primaryLanguage   JobLanguage
  otherLanguagesText String?

  cvUrl String

  consentUseCv      Boolean @default(false)
  accuracyConfirmed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformSetting {
  key String @id

  value Json

  updatedByAdminId String?
  updatedByAdmin   User?   @relation("PlatformSettingUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedByAdminId, updatedAt])
}

model AuditLog {
  id String @id @default(cuid())

  adminId String
  admin   User   @relation("AuditActor", fields: [adminId], references: [id], onDelete: Cascade)

  action     AuditAction
  objectType String?
  objectId   String?
  beforeJson Json?
  afterJson  Json?

  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
}

model UserAdminNote {
  id String @id @default(cuid())

  userId String
  user   User   @relation("AdminNoteUser", fields: [userId], references: [id], onDelete: Cascade)

  adminId String
  admin   User   @relation("AdminNoteAuthor", fields: [adminId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}

model Report {
  id String @id @default(cuid())

  targetType ReportTargetType
  targetId   String?
  status     ReportStatus     @default(OPEN)

  reason      String?
  detailsJson Json?

  reporterId String?
  reporter   User?   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  resolvedById   String?
  resolvedBy     User?     @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetType, createdAt])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

model UserSettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Compte
  language String  @default("FR")
  timezone String  @default("UTC")
  country  String?

  // Confidentialité
  showOnlineStatus     Boolean @default(true)
  showLastSeen         Boolean @default(true)
  showCountryOnProfile Boolean @default(true)
  communityVisible     Boolean @default(true)

  // Statut & présence
  autoAwayMinutes Int @default(30)

  // Notifications
  notifyInApp           Boolean @default(true)
  notifyEmail           Boolean @default(false)
  notifyRequests        Boolean @default(true)
  notifyDocuments       Boolean @default(true)
  notifyPayments        Boolean @default(true)
  notifyMeetings        Boolean @default(true)
  notifyEvents          Boolean @default(true)
  notifyMarketplace     Boolean @default(true)
  notificationFrequency String  @default("IMMEDIATE")

  // Marketplace / Performance (PRO)
  allowFollow        Boolean @default(true)
  showFollowersCount Boolean @default(true)
  showBadges         Boolean @default(true)
  allowReviews       Boolean @default(true)
  showRatingPublicly Boolean @default(true)
  showReviewComments Boolean @default(true)

  // Données
  deletionRequestedAt DateTime?
  deletionScheduledAt DateTime?

  updatedAt DateTime @updatedAt
}

model PreRegistration {
  id     String @id @default(cuid())
  userId String @unique

  status PreRegistrationStatus @default(DRAFT)

  firstName String?
  lastName  String?
  email     String?
  phone     String?
  language  CommunicationLanguage?

  countryOfResidence String?
  city               String?
  nationality        String?
  residenceSituation ResidenceSituation?

  mainObjective MainObjective?
  needsJson     Json?

  professionalSituation ProfessionalSituation?
  domain                MainDomain?
  educationLevel        EducationLevel?
  experienceRange       ExperienceRange?

  budgetRange      BudgetRange?
  constraintsJson  Json?
  constraintsOther String?

  message String?

  disclaimerAccepted Boolean @default(false)
  contactAccepted    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  review   PreRegistrationReview?
  meetings Meeting[]

  @@index([userId])
}

model PreRegistrationReview {
  id String @id @default(cuid())

  preRegistrationId String          @unique
  preRegistration   PreRegistration @relation(fields: [preRegistrationId], references: [id], onDelete: Cascade)

  status           PreRegistrationReviewStatus @default(NEW)
  feasibility      ReviewFeasibility?
  recommendedTrack String?
  internalNotes    String?

  assignedProId String?
  assignedPro   User?   @relation(fields: [assignedProId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedProId])
  @@index([status])
}

model Meeting {
  id String @id @default(cuid())

  clientId String
  client   User   @relation("MeetingClient", fields: [clientId], references: [id], onDelete: Cascade)

  proId String
  pro   User   @relation("MeetingPro", fields: [proId], references: [id], onDelete: Cascade)

  preRegistrationId String?
  preRegistration   PreRegistration? @relation(fields: [preRegistrationId], references: [id], onDelete: SetNull)

  title  String
  type   MeetingType   @default(OTHER)
  status MeetingStatus @default(SCHEDULED)

  startsAt    DateTime
  durationMin Int      @default(30)

  locationUrl   String?
  notesInternal String?

  marketplaceRequest MarketplaceRequest? @relation("MarketplaceRequestMeeting")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([proId])
  @@index([startsAt])
}

model MarketplaceProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status     MarketplaceProfileStatus @default(DRAFT)
  isVerified Boolean                  @default(false) // Gardé pour compatibilité, à déprécier

  // Nouveau système de vérification
  verificationStatus VerificationStatus @default(DRAFT)
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?              @relation("ProfileVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectionReason    String?

  // Badges attribués manuellement par admin
  badgesJson Json? // ["VERIFIED", "PARTNER", "TOP_CONTRIBUTOR"]

  profession   MarketplaceProfession
  // V2 - taxonomie métiers (métier principal + secondaires)
  // NOTE: on garde `profession` pour compat, mais l’UI doit basculer vers ces champs.
  primaryProfessionId       String?
  secondaryProfessionIdsJson Json?
  headline     String?
  organization String?

  country String
  city    String

  languagesJson       Json?
  themesJson          Json?
  specialtiesJson     Json?
  servicesJson        Json?
  targetAudiencesJson Json?
  availabilityJson    Json?

  format       MarketplaceFormat        @default(VISIO)
  responseTime MarketplaceResponseTime?

  licenseNumber    String?
  licenseAuthority String?
  proofUrl         String?

  // Vérification Pro (documents)
  // - proofUrl: justificatif de compétence (certificat/diplôme/licence...)
  // - idProofUrl: pièce d’identité (recto/verso si possible)
  idProofUrl              String?
  verificationRequestedAt DateTime?

  bioShort String?
  bioLong  String?

  employerDetails String?

  pricingMode MarketplacePricingMode @default(FREE)
  price30Min  Int?
  price60Min  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests MarketplaceRequest[]

  @@index([status])
  @@index([profession])
  @@index([primaryProfessionId])
  @@index([country])
  @@index([city])
}

model MarketplaceRequest {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("MarketplaceRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  professionalId String
  professional   User   @relation("MarketplaceProfessional", fields: [professionalId], references: [id], onDelete: Cascade)

  profileId String?
  profile   MarketplaceProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  status             MarketplaceRequestStatus @default(PENDING)
  topic              MarketplaceNeedTopic?
  urgency            MarketplaceUrgency?
  preferredTimeframe String?
  message            String?

  proNote String?

  // Performance tracking (V1)
  acceptedAt         DateTime?
  firstProResponseAt DateTime?
  closedByClientAt   DateTime?

  meetingId String?  @unique
  meeting   Meeting? @relation("MarketplaceRequestMeeting", fields: [meetingId], references: [id], onDelete: SetNull)

  requesterLastReadAt    DateTime?
  professionalLastReadAt DateTime?
  lastActivityAt         DateTime  @default(now())

  messages MarketplaceRequestMessage[]

  engagement MarketplaceEngagement?

  paymentOrders PaymentOrder[]

  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId, status])
  @@index([requesterId])
  @@index([createdAt])
  @@index([lastActivityAt])
}

model MarketplaceRequestMessage {
  id String @id @default(cuid())

  requestId String
  request   MarketplaceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  senderRole MarketplaceMessageSenderRole
  kind       MarketplaceMessageKind       @default(TEXT)

  body     String?
  fileUrl  String?
  fileName String?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

model MarketplaceEngagement {
  id String @id @default(cuid())

  requestId String @unique
  request   MarketplaceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  requesterId String
  requester   User @relation("MarketplaceEngagementRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  professionalId String
  professional   User @relation("MarketplaceEngagementProfessional", fields: [professionalId], references: [id], onDelete: Cascade)

  status MarketplaceEngagementStatus @default(DRAFT)

  contractTitle  String
  contractBody   String
  contractSentAt DateTime?

  signedAt       DateTime?
  signedByUserId String?
  signedByUser   User? @relation("MarketplaceEngagementSigner", fields: [signedByUserId], references: [id], onDelete: SetNull)
  signedByName   String?

  paymentRequestedAt DateTime?
  paidAt             DateTime?

  milestone       MarketplaceMilestone @default(ANALYSE)
  analyseDoneAt   DateTime?
  dossierDoneAt   DateTime?
  soumissionDoneAt DateTime?

  completedAt DateTime?
  canceledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId, status, createdAt])
  @@index([requesterId, status, createdAt])
}

model Review {
  id String @id @default(cuid())

  professionalId String
  professional   User   @relation("ReviewProfessional", fields: [professionalId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  marketplaceRequestId String
  marketplaceRequest   MarketplaceRequest @relation(fields: [marketplaceRequestId], references: [id], onDelete: Cascade)

  rating  Int // 1-5
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, marketplaceRequestId])
  @@index([professionalId])
  @@index([authorId])
  @@index([createdAt])
}

model ProfessionalNetwork {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())

  owner   User                        @relation("ProNetworkOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members ProfessionalNetworkMember[]

  @@index([ownerId])
}

model ProfessionalNetworkMember {
  networkId String
  userId    String
  role      ProNetworkRole @default(MEMBER)
  createdAt DateTime       @default(now())

  network ProfessionalNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([networkId, userId])
  @@index([userId])
}

model Event {
  id            String   @id @default(cuid())
  
  // Core info
  title         String
  description   String
  objectives    String?  // JSON meta (legacy)
  audience      String?
  prerequisites String?
  durationMin   Int?
  slug          String   @unique
  
  // Metadata
  type     EventType
  theme    EventTheme
  level    EventLevel
  format   EventFormat
  mode     EventMode   @default(ONLINE)
  status   ProEventStatus @default(DRAFT)
  
  // Scheduling
  startsAt DateTime?
  
  // Links & media
  liveUrl    String?
  replayUrl  String?
  bannerUrl  String?
  isFeatured Boolean  @default(false)
  
  // Pricing
  isPaid Boolean @default(false)
  price  Decimal?
  
  // Creator
  createdBy String
  creator   User @relation("EventsCreated", fields: [createdBy], references: [id], onDelete: Cascade)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  speakers      EventSpeaker[]
  registrations EventRegistration[]
  orders        EventOrder[]
  likes         EventLike[]
  
  @@index([createdBy])
  @@index([status])
  @@index([slug])
}

model EventOrder {
  id               String      @id @default(cuid())
  eventId          String
  userId           String
  amount           Decimal
  currency         String      @default("cad")
  status           OrderStatus @default(PENDING)
  stripeSessionId  String?     @unique
  
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@index([status])
}

model Speaker {
  id        String   @id @default(cuid())
  fullName  String
  title     String?
  bio       String?
  avatarUrl String?
  createdAt DateTime @default(now())

  events EventSpeaker[]
}

model EventSpeaker {
  eventId   String
  speakerId String

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([eventId, speakerId])
  @@index([speakerId])
}

model EventRegistration {
  eventId   String
  userId    String
  status    EventRegistrationStatus @default(REGISTERED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@index([status])
}

model EventLike {
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model ContactRequest {
  id        String        @id @default(cuid())
  fromId    String
  toId      String
  status    RequestStatus @default(PENDING)
  message   String?
  createdAt DateTime      @default(now())

  from User @relation("ContactFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ContactTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
}

model PartnershipRequest {
  id        String        @id @default(cuid())
  fromId    String
  toId      String
  status    RequestStatus @default(PENDING)
  message   String?
  createdAt DateTime      @default(now())

  from User @relation("PartnershipFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("PartnershipTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
}

model UserPost {
  id             String        @id @default(cuid())
  userId         String
  title          String?
  content        String
  mediaUrl       String?
  mediaType      UserMediaType @default(NONE)
  targetAccountType AccountType?
  isAdminPost     Boolean       @default(false)
  isHidden       Boolean       @default(false)
  commentsLocked Boolean       @default(false)
  pinnedAt       DateTime?
  likes          Int           @default(0)
  shares         Int           @default(0)
  createdAt      DateTime      @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments UserPostComment[]
  likesRel UserPostLike[]

  @@index([userId])
}

model UserPostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  message   String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())

  post UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model CommunityRules {
  id String @id @default(cuid())

  // Enforce singleton row
  singleton Int @unique @default(1)

  publishMode CommunityPublishMode @default(ADMIN_ONLY)
  commentMode CommunityCommentMode @default(ALL_USERS)

  allowLinks  Boolean @default(true)
  allowImages Boolean @default(true)

  spamPostCooldownSeconds Int @default(3600)
  maxPostsPerDay          Int @default(3)

  bannedWords       String                @default("[]")
  bannedWordsAction CommunityBannedWordsAction @default(HIDE)

  updatedByAdminId String?
  updatedByAdmin   User? @relation("CommunityRulesUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([updatedAt])
  @@index([updatedByAdminId, updatedAt])
}

model UserPostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model AdminPost {
  id             String    @id @default(cuid())
  adminLabel     String
  content        String
  isHidden       Boolean   @default(false)
  commentsLocked Boolean   @default(false)
  pinnedAt       DateTime?
  likes          Int       @default(0)
  shares         Int       @default(0)
  createdAt      DateTime  @default(now())

  comments AdminComment[]
}

model AdminComment {
  id          String   @id @default(cuid())
  postId      String
  authorLabel String
  message     String
  createdAt   DateTime @default(now())

  post AdminPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Dossier {
  id        String        @id @default(cuid())
  userId    String
  program   String
  status    DossierStatus @default(LOCAL)
  createdAt DateTime      @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  messages  DossierMessage[]

  @@index([userId])
}

model DossierMessage {
  id        String   @id @default(cuid())
  dossierId String
  senderId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  
  dossier   Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  sender    User     @relation("DossierMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([senderId])
}

model Document {
  id        String         @id @default(cuid())
  dossierId String
  name      String
  status    DocumentStatus @default(A_FOURNIR)
  note      String?
  url       String?
  mimeType  String?

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
}

model PaymentService {
  id String @id @default(cuid())

  providerUserId String?
  providerUser   User?   @relation(fields: [providerUserId], references: [id], onDelete: SetNull)

  contentItemId String? @unique
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  priceCents      Int
  currency        String  @default("cad")
  durationMinutes Int?
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders PaymentOrder[]

  @@index([providerUserId])
  @@index([contentItemId])
  @@index([active])
}

model StripeConnectedAccount {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeAccountId  String @unique
  chargesEnabled   Boolean @default(false)
  payoutsEnabled   Boolean @default(false)
  detailsSubmitted Boolean @default(false)

  requirementsDueJson Json?

  paymentOrders PaymentOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PaymentOrder {
  id String @id @default(cuid())

  marketplaceRequestId String?
  marketplaceRequest   MarketplaceRequest? @relation(fields: [marketplaceRequestId], references: [id], onDelete: SetNull)

  buyerUserId String
  buyerUser   User   @relation("PaymentOrderBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)

  providerUserId String
  providerUser   User   @relation("PaymentOrderProvider", fields: [providerUserId], references: [id], onDelete: Cascade)

  connectedAccountId String?
  connectedAccount   StripeConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)

  serviceId String
  service   PaymentService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  status      PaymentOrderStatus @default(DRAFT)
  amountCents Int
  currency    String             @default("cad")

  // Commission CAPITUNE (V2 Connect) — stockée au moment de la création pour audit
  applicationFeeCents Int?

  paidAt     DateTime?
  refundedAt DateTime?
  canceledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([marketplaceRequestId])
  @@index([buyerUserId])
  @@index([providerUserId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id String @id @default(cuid())

  orderId String
  order   PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  status    PaymentStatus @default(CREATED)
  paidAt    DateTime?
  refundedAt DateTime?
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@index([status])
}

model StripeWebhookEvent {
  id String @id @default(cuid())

  stripeEventId   String @unique
  stripeEventType String
  payloadJson     Json?

  createdAt DateTime @default(now())

  @@index([stripeEventType, createdAt])
}

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum JobType {
  STAGE
  CDD
  CDI
  MISSION
  FREELANCE
}

enum ExperienceLevel {
  ENTRY
  INTERMEDIATE
  SENIOR
  EXPERT
}

enum JobApplicationStatus {
  RECUE
  EN_COURS
  RETENUE
  REFUSEE
}

enum JobLanguage {
  FR
  EN
  BILINGUE
}

// ============================================================================
// CASES (V1 réduit)
// ============================================================================

enum CaseStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  DONE
}

model Case {
  id             String     @id @default(cuid())
  requesterId    String
  professionalId String
  serviceId      String?
  title          String
  description    String
  status         CaseStatus @default(PENDING)
  lastActivityAt DateTime   @default(now())
  requesterLastReadAt    DateTime?
  professionalLastReadAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  requester    User @relation("CaseRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  professional User @relation("CaseProfessional", fields: [professionalId], references: [id], onDelete: Cascade)

  messages  CaseMessage[]
  documents CaseDocument[]

  @@index([requesterId, status, createdAt])
  @@index([professionalId, status, createdAt])
  @@index([lastActivityAt])
}

model CaseMessage {
  id        String   @id @default(cuid())
  caseId    String
  authorId  String
  body      String?
  fileUrl   String?
  fileName  String?
  createdAt DateTime @default(now())

  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation("CaseMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([authorId])
}

model CaseDocument {
  id        String   @id @default(cuid())
  caseId    String
  name      String
  url       String
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model JobPosting {
  id String @id @default(cuid())

  posterId String
  poster   User   @relation("JobPoster", fields: [posterId], references: [id], onDelete: Cascade)

  title        String
  description  String
  requirements String?

  jobType         JobType         @default(CDI)
  domain          MainDomain      @default(AUTRE)
  experienceLevel ExperienceLevel @default(INTERMEDIATE)

  city     String?
  province String?
  remote   Boolean @default(false)

  languages JobLanguage @default(FR)

  startDate DateTime?
  deadline  DateTime?

  salaryMin Int?
  salaryMax Int?
  currency  String @default("CAD")

  status JobPostingStatus @default(DRAFT)

  applications JobApplication[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  closedAt    DateTime?

  @@index([posterId])
  @@index([status])
  @@index([createdAt])
  @@index([publishedAt])
}

model JobApplication {
  id String @id @default(cuid())

  jobId String
  job   JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  applicantId String
  applicant   User   @relation("JobApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  cvUrl String

  status JobApplicationStatus @default(RECUE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// MESSAGING SYSTEM
// ============================================================================

model Conversation {
  id String @id @default(cuid())

  // Participants (always 2: initiator and recipient)
  initiatorId String
  initiator   User   @relation("ConversationInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User   @relation("ConversationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  messages Message[]

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  // Ensure unique conversation between two users (bidirectional)
  @@unique([initiatorId, recipientId])
  @@index([initiatorId])
  @@index([recipientId])
  @@index([lastMessageAt])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  content String @db.Text

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isRead])
}
